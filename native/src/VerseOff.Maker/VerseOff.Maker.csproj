    <ProjectReference Include="../VerseOff.Generator/VerseOff.Generator.csproj" />
    <ProjectReference Include="../VerseOff.Customization/VerseOff.Customization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.0.0" />
  </ItemGroup>

</Project>
