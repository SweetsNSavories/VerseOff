<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VerseOff.App.MainPage">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#111111}">
        <Grid Grid.Row="0"
              Padding="24,18"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">
            <VerticalStackLayout Spacing="2">
                <Label Text="VerseOff Maker"
                       FontSize="24"
                       FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Generate a clean-room native target from a selected model-driven app"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#605E5C, Dark=#C8C6C4}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    Padding="12,6"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#FFF4CE"
                    Stroke="#EAA300">
                <Label Text="Native .NET"
                       TextColor="#6A4B00"
                       FontAttributes="Bold" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28"
                                 Spacing="18"
                                 MaximumWidthRequest="1180">
                <Border Padding="20"
                        Stroke="#E1DFDD"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="1. Load an exported solution"
                               FontSize="20"
                               FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="Choose a Dataverse solution ZIP, or enter the path of an unpacked solution folder. The package is bounded, parsed without extraction, and validated against published Microsoft schemas."
                               LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8">
                            <Entry Text="{Binding SourcePath}"
                                   Placeholder="C:\Exports\ContosoSolution.zip" />
                            <Button Grid.Column="1"
                                    Text="Browse ZIP"
                                    Clicked="OnBrowseSolution" />
                            <Button Grid.Column="2"
                                    Text="Load apps"
                                    IsEnabled="{Binding CanLoad}"
                                    Clicked="OnLoadSolution" />
                        </Grid>
                        <Label Text="{Binding SolutionSummary}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#605E5C, Dark=#C8C6C4}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20"
                        Stroke="#E1DFDD"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="2. Select the model-driven app"
                               FontSize="20"
                               FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level2" />
                        <CollectionView ItemsSource="{Binding Applications}"
                                        SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        HeightRequest="220">
                            <CollectionView.EmptyView>
                                <Label Text="No apps loaded."
                                       Padding="10"
                                       TextColor="{AppThemeBinding Light=#605E5C, Dark=#C8C6C4}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            Margin="0,3"
                                            Stroke="#E1DFDD"
                                            StrokeShape="RoundRectangle 6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding DisplayName}"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding UniqueName}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#605E5C, Dark=#C8C6C4}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding AppModuleId}"
                                                   FontSize="10"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#605E5C, Dark=#C8C6C4}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox IsChecked="{Binding CustomerOwnershipConfirmed}" />
                            <Label Text="{Binding OwnershipText}"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20"
                        Stroke="#E1DFDD"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="3. Generate the target source"
                               FontSize="20"
                               FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="VerseOff generates a deterministic Windows-first .NET MAUI source tree with the selected app's canonical metadata, native form renderer, generation manifest, and no Microsoft proprietary bundles."
                               LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Entry Text="{Binding OutputRoot}"
                                   Placeholder="Output parent folder" />
                            <Button Grid.Column="1"
                                    Text="Generate source"
                                    IsEnabled="{Binding CanGenerate}"
                                    Clicked="OnGenerateSource" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14"
                        Stroke="#8A8886"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="{AppThemeBinding Light=#F3F2F1, Dark=#292929}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#0F6CBD" />
                        <Label Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               VerticalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
