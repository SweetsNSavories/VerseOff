# Generate tests for OnLoad and OnChange events to catch JS errors
def test_javascript_event_execution(form, qtbot):
    """
    If the downloaded JS has unsupported DOM manipulations, 
    triggering the events will throw exceptions or log errors.
    """
    # Trigger OnLoad
    try:
        form.trigger_onload()
    except Exception as e:
        pytest.fail(f"OnLoad JS execution failed: {e}")
        
    # Trigger OnChange for fields that have them
    {% for tab in form.tabs %}
    {% for section in tab.sections %}
    {% for control in section.controls %}
    {% if control.events %}
    try:
        {% if control.type == 'text' %}
        widget = form.widgets["{{ control.attribute }}"]
        qtbot.keyClicks(widget, "Trigger")
        widget.editingFinished.emit() # Force trigger
        {% endif %}
    except Exception as e:
        pytest.fail(f"OnChange JS execution for {{ control.attribute }} failed: {e}")
    {% endif %}
    {% endfor %}
    {% endfor %}
    {% endfor %}
