            ("📋  Customer Voice alert", "customervoicealert"),
            ("📋  Invite Redemption", "inviteredemption"),
            ("💬  Outbound message", "outboundmessage"),
            ("💬  Portal Comment", "portalcomment"),
            ("💻  Session", "session"),
            ("🎙  Voicemail", "voicemail"),
        ]
        for label, act_type in activities:
            action = act_menu.addAction(label)
