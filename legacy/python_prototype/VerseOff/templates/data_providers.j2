"""
Remote provider extension points for the generated VerseOff application.

VerseOff Maker preserves this file when a project is regenerated.
"""
from abc import ABC, abstractmethod

import requests


class IRemoteProvider(ABC):
    @abstractmethod
    def get_record(self, logical_name: str, record_id: str) -> dict:
        raise NotImplementedError

    @abstractmethod
    def create_record(self, logical_name: str, payload: dict) -> dict:
        raise NotImplementedError

    @abstractmethod
    def update_record(
        self,
        logical_name: str,
        record_id: str,
        payload: dict,
        etag: str | None = None,
    ):
        raise NotImplementedError


class DataverseProvider(IRemoteProvider):
    def __init__(
        self,
        org_url: str,
        auth_token: str,
        entity_sets: dict[str, str],
        timeout: int = 30,
    ):
        if not auth_token:
            raise ValueError("DataverseProvider requires an access token.")
        self.api_url = f"{org_url.rstrip('/')}/api/data/v9.2"
        self.entity_sets = entity_sets
        self.timeout = timeout
        self.session = requests.Session()
        self.session.headers.update({
            "Authorization": f"Bearer {auth_token}",
            "Accept": "application/json",
            "Content-Type": "application/json; charset=utf-8",
            "OData-MaxVersion": "4.0",
            "OData-Version": "4.0",
        })

    def _entity_set(self, logical_name: str) -> str:
        entity_set = self.entity_sets.get(logical_name)
        if not entity_set:
            raise KeyError(
                f"No EntitySetName metadata is available for {logical_name}."
            )
        return entity_set

    def get_record(self, logical_name: str, record_id: str) -> dict:
        entity_set = self._entity_set(logical_name)
        response = self.session.get(
            f"{self.api_url}/{entity_set}({record_id.strip('{}')})",
            timeout=self.timeout,
        )
        response.raise_for_status()
        return response.json()

    def create_record(self, logical_name: str, payload: dict) -> dict:
        entity_set = self._entity_set(logical_name)
        response = self.session.post(
            f"{self.api_url}/{entity_set}",
            json=payload,
            headers={"Prefer": "return=representation"},
            timeout=self.timeout,
        )
        response.raise_for_status()
        return response.json() if response.content else {}

    def update_record(
        self,
        logical_name: str,
        record_id: str,
        payload: dict,
        etag: str | None = None,
    ):
        entity_set = self._entity_set(logical_name)
        response = self.session.patch(
            f"{self.api_url}/{entity_set}({record_id.strip('{}')})",
            json=payload,
            headers={"If-Match": etag or "*"},
            timeout=self.timeout,
        )
        response.raise_for_status()


class FallbackRESTProvider(IRemoteProvider):
    """Optional REST fallback that can be configured by the app developer."""

    def __init__(
        self,
        base_url: str,
        auth_token: str = "",
        timeout: int = 30,
    ):
        if not base_url:
            raise ValueError("FallbackRESTProvider requires a base URL.")
        self.base_url = base_url.rstrip("/")
        self.timeout = timeout
        self.session = requests.Session()
        if auth_token:
            self.session.headers["Authorization"] = f"Bearer {auth_token}"

    def get_record(self, logical_name: str, record_id: str) -> dict:
        response = self.session.get(
            f"{self.base_url}/{logical_name}/{record_id}",
            timeout=self.timeout,
        )
        response.raise_for_status()
        return response.json()

    def create_record(self, logical_name: str, payload: dict) -> dict:
        response = self.session.post(
            f"{self.base_url}/{logical_name}",
            json=payload,
            timeout=self.timeout,
        )
        response.raise_for_status()
        return response.json() if response.content else {}

    def update_record(
        self,
        logical_name: str,
        record_id: str,
        payload: dict,
        etag: str | None = None,
    ):
        headers = {"If-Match": etag} if etag else {}
        response = self.session.patch(
            f"{self.base_url}/{logical_name}/{record_id}",
            json=payload,
            headers=headers,
            timeout=self.timeout,
        )
        response.raise_for_status()
