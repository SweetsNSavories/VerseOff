DATAVERSE_URL = "{{ dataverse_url }}"


class SyncWorker(QThread):
    status_update = pyqtSignal(str)

    def __init__(self, dataverse_url):
        super().__init__()
        self.engine = SyncEngine(dataverse_url)

    def run(self):
        self.status_update.emit("Syncing to Dataverse...")
        try:
            self.engine.sync_pending_records()
            self.status_update.emit("Sync complete.")
        except Exception as e:
            self.status_update.emit(f"Sync failed: {e}")


