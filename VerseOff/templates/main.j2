        self.status_bar = QStatusBar()
        self.setStatusBar(self.status_bar)
        self.status_bar.showMessage("Offline — data saved locally to SQLite.")

        if self.nav_buttons:
            self._switch(0)

    def _switch(self, index):
        self.stack.setCurrentIndex(index)
        for i, btn in enumerate(self.nav_buttons):
            btn.setChecked(i == index)

    def _run_sync(self):
        self.status_bar.showMessage("Connecting to Dataverse...")
        self.sync_worker = SyncWorker(DATAVERSE_URL)
        self.sync_worker.status_update.connect(self.status_bar.showMessage)
        self.sync_worker.start()


