"""
{{ entity.DisplayName }} Form — Generated by VerseOff Maker
Entity: {{ entity.LogicalName }}
"""
import uuid
import json
import sqlite3
from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel, QLineEdit,
    QTextEdit, QComboBox, QCheckBox, QDateTimeEdit, QScrollArea,
    QPushButton, QFrame, QSpinBox, QDoubleSpinBox, QMessageBox,
    QSizePolicy, QFormLayout, QGroupBox
)
from PyQt6.QtCore import Qt, QDateTime
from PyQt6.QtGui import QFont
import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(__file__)))
import db


class {{ entity.LogicalName | capitalize }}Form(QWidget):
    ENTITY_NAME = "{{ entity.LogicalName }}"
    ENTITY_DISPLAY = "{{ entity.DisplayName }}"

    def __init__(self):
        super().__init__()
        self._controls = {}
        self._build_ui()
        self._load_recent_records()

    def _build_ui(self):
        root = QHBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)

        # -- Form panel (left) --
        form_panel = QFrame()
        form_panel.setStyleSheet("background:#1e1e2e;")
        form_layout = QVBoxLayout(form_panel)
        form_layout.setContentsMargins(24, 24, 24, 24)

        header = QLabel(f"New {self.ENTITY_DISPLAY}")
        header.setFont(QFont("Segoe UI", 14, QFont.Weight.Bold))
        header.setStyleSheet("color:#cba6f7; margin-bottom:8px;")
        form_layout.addWidget(header)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("border:none; background:transparent;")
        inner = QWidget()
        inner.setStyleSheet("background:transparent;")
        scroll.setWidget(inner)
        inner_layout = QVBoxLayout(inner)
        inner_layout.setSpacing(6)

        {% for tab in form.tabs %}
        # Tab: {{ tab.label }}
        {% for section in tab.sections %}
        grp_{{ loop.index }} = QGroupBox("{{ section.label }}")
        grp_{{ loop.index }}.setStyleSheet(
            "QGroupBox{color:#a6adc8;font-size:10px;font-weight:bold;"
            "border:1px solid #313244;border-radius:8px;margin-top:12px;padding:12px;}"
            "QGroupBox::title{subcontrol-origin:margin;left:10px;padding:0 4px;}"
        )
        grp_layout_{{ loop.index }} = QFormLayout(grp_{{ loop.index }})
        grp_layout_{{ loop.index }}.setSpacing(10)
        {% for ctrl in section.controls %}
        # Control: {{ ctrl.attribute }} ({{ ctrl.type }})
        lbl_{{ ctrl.attribute }} = QLabel("{{ ctrl.label }}{% if ctrl.required %} *{% endif %}")
        lbl_{{ ctrl.attribute }}.setStyleSheet("color:#cdd6f4; font-size:11px;")
        {% if ctrl.type == "text" %}
        field_{{ ctrl.attribute }} = QLineEdit()
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:6px;")
        field_{{ ctrl.attribute }}.setPlaceholderText("Enter {{ ctrl.label }}...")
        {% elif ctrl.type == "memo" %}
        field_{{ ctrl.attribute }} = QTextEdit()
        field_{{ ctrl.attribute }}.setMaximumHeight(80)
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:6px;")
        field_{{ ctrl.attribute }}.setPlaceholderText("Enter {{ ctrl.label }}...")
        {% elif ctrl.type == "picklist" %}
        field_{{ ctrl.attribute }} = QComboBox()
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:5px;")
        field_{{ ctrl.attribute }}.addItem("-- Select --", None)
        {% for opt in ctrl.options %}
        field_{{ ctrl.attribute }}.addItem("{{ opt.label }}", {{ opt.value }})
        {% endfor %}
        {% elif ctrl.type == "boolean" %}
        field_{{ ctrl.attribute }} = QCheckBox("{{ ctrl.label }}")
        field_{{ ctrl.attribute }}.setStyleSheet("color:#cdd6f4;")
        {% elif ctrl.type == "datetime" %}
        field_{{ ctrl.attribute }} = QDateTimeEdit(QDateTime.currentDateTime())
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:5px;")
        field_{{ ctrl.attribute }}.setCalendarPopup(True)
        {% elif ctrl.type == "integer" %}
        field_{{ ctrl.attribute }} = QSpinBox()
        field_{{ ctrl.attribute }}.setRange(-2147483648, 2147483647)
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:5px;")
        {% elif ctrl.type == "decimal" %}
        field_{{ ctrl.attribute }} = QDoubleSpinBox()
        field_{{ ctrl.attribute }}.setRange(-1e12, 1e12)
        field_{{ ctrl.attribute }}.setDecimals(2)
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:5px;")
        {% elif ctrl.type == "lookup" %}
        field_{{ ctrl.attribute }} = QLineEdit()
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:6px;")
        field_{{ ctrl.attribute }}.setPlaceholderText("Search {{ ctrl.label }}...")
        {% else %}
        field_{{ ctrl.attribute }} = QLineEdit()
        field_{{ ctrl.attribute }}.setStyleSheet("background:#313244;color:#cdd6f4;border:1px solid #45475a;border-radius:5px;padding:6px;")
        {% endif %}
        self._controls["{{ ctrl.attribute }}"] = field_{{ ctrl.attribute }}
        grp_layout_{{ loop.index }}.addRow(lbl_{{ ctrl.attribute }}, field_{{ ctrl.attribute }})
        {% endfor %}
        inner_layout.addWidget(grp_{{ loop.index }})
        {% endfor %}
        {% endfor %}

        inner_layout.addStretch()
        form_layout.addWidget(scroll)

        # Save button
        btn_save = QPushButton("💾  Save Offline")
        btn_save.setStyleSheet(
            "QPushButton{background:#a6e3a1;color:#1e1e2e;border:none;"
            "padding:10px 20px;border-radius:8px;font-weight:bold;font-size:12px;}"
            "QPushButton:hover{background:#94e2d5;}"
        )
        btn_save.clicked.connect(self._save_record)
        form_layout.addWidget(btn_save)

        # -- Records panel (right) --
        records_panel = QFrame()
        records_panel.setFixedWidth(280)
        records_panel.setStyleSheet("background:#181825;border-left:1px solid #313244;")
        rec_layout = QVBoxLayout(records_panel)
        rec_layout.setContentsMargins(12, 20, 12, 12)

        rec_header = QLabel(f"Saved {self.ENTITY_DISPLAY} Records")
        rec_header.setFont(QFont("Segoe UI", 10, QFont.Weight.Bold))
        rec_header.setStyleSheet("color:#a6adc8; margin-bottom:8px;")
        rec_layout.addWidget(rec_header)

        from PyQt6.QtWidgets import QListWidget
        self.record_list = QListWidget()
        self.record_list.setStyleSheet(
            "QListWidget{background:#1e1e2e;color:#cdd6f4;border:none;font-size:11px;}"
            "QListWidget::item{padding:8px;border-bottom:1px solid #313244;}"
            "QListWidget::item:selected{background:#313244;color:#cba6f7;}"
        )
        rec_layout.addWidget(self.record_list)

        root.addWidget(form_panel, stretch=1)
        root.addWidget(records_panel)

    def _get_values(self) -> dict:
        data = {}
        for key, widget in self._controls.items():
            if isinstance(widget, QLineEdit):
                data[key] = widget.text()
            elif isinstance(widget, QTextEdit):
                data[key] = widget.toPlainText()
            elif isinstance(widget, QComboBox):
                data[key] = widget.currentData()
            elif isinstance(widget, QCheckBox):
                data[key] = widget.isChecked()
            elif isinstance(widget, QDateTimeEdit):
                data[key] = widget.dateTime().toString(Qt.DateFormat.ISODate)
            elif isinstance(widget, (QSpinBox, QDoubleSpinBox)):
                data[key] = widget.value()
        return data

    def _save_record(self):
        values = self._get_values()
        record_id = str(uuid.uuid4())
        conn = sqlite3.connect(db.DB_PATH)
        conn.execute(
            "INSERT INTO cached_records (id, entity_name, data_json, sync_status, priority_score, source) "
            "VALUES (?, ?, ?, 'pending', 10, 'offline')",
            (record_id, self.ENTITY_NAME, json.dumps(values))
        )
        conn.commit()
        conn.close()
        QMessageBox.information(self, "Saved", f"{self.ENTITY_DISPLAY} saved offline!\nID: {record_id[:8]}...")
        self._load_recent_records()

    def _load_recent_records(self):
        self.record_list.clear()
        conn = sqlite3.connect(db.DB_PATH)
        rows = conn.execute(
            "SELECT id, data_json, sync_status FROM cached_records WHERE entity_name=? ORDER BY last_modified DESC LIMIT 20",
            (self.ENTITY_NAME,)
        ).fetchall()
        conn.close()
        for row_id, data_json, status in rows:
            data = json.loads(data_json)
            # Try to find a sensible display name
            primary = next((v for v in data.values() if isinstance(v, str) and v.strip()), row_id[:8])
            status_icon = "✓" if status == "synced" else "⏳" if status == "pending" else "✗"
            from PyQt6.QtWidgets import QListWidgetItem
            item = QListWidgetItem(f"{status_icon}  {primary[:35]}")
            self.record_list.addItem(item)
