                font-weight: bold;
            }
            QTreeWidget::item:hover {
                background-color: #f8f9fa;
            }
            QTableWidget {
                background-color: #ffffff;
                border: 1px solid #e1dfdd;
                border-radius: 6px;
                gridline-color: #edebe9;
                selection-background-color: #cce4f7;
                selection-color: #000000;
            }
            QTableWidget::item {
                padding: 6px;
            }
            QHeaderView::section {
                background-color: #faf9f8;
                color: #323130;
                font-weight: bold;
                padding: 8px 6px;
                border: none;
