import os
import sys

from PyQt6.QtCore import Qt
from PyQt6.QtWidgets import QComboBox as QtComboBox


def _resource_path(filename):
    base_dir = getattr(
        sys,
        "_MEIPASS",
        os.path.dirname(os.path.abspath(__file__)),
    )
    return os.path.join(base_dir, filename).replace("\\", "/")


class FluentComboBox(QtComboBox):
    """Combo box using the packaged Fluent chevron SVG."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setProperty("fluentChevron", True)
        self.setMinimumHeight(30)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self._chevron_style = f"""
            QComboBox::drop-down {{
                border: none;
                width: 28px;
            }}
            QComboBox::down-arrow {{
                image: url("{_resource_path('fluent_chevron.svg')}");
                width: 12px;
                height: 7px;
            }}
        """
        super().setStyleSheet(self._chevron_style)

    def setStyleSheet(self, style_sheet):
        super().setStyleSheet(
            f"{style_sheet}\n{self._chevron_style}"
        )
